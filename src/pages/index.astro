---
import Layout from '../layouts/Layout.astro';
const phone = "+16072289269";
const phoneDisplay = "+1 (607) 228-9269";
---

<Layout title="AC Repair in Gastonia, NC | Same-Day AC Repair | acrepairgastonianc.com">
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <h1>AC Repair in Gastonia, North Carolina</h1>
        <p class="hero-tagline">Fast Fixes. Real Relief. Same-Day Service.</p>
        <p class="hero-desc">
          When your AC breaks down in the Gastonia heat, every minute costs. Our
          licensed technicians are on call around the clock — delivering expert
          repairs, upfront pricing, and workmanship backed by a written guarantee
          for every home in Gaston County.
        </p>
        <div class="hero-cta">
          <a href={`tel:${phone}`} class="btn btn-primary btn-lg">Call {phoneDisplay}</a>
          <a href="/location/" class="btn btn-outline btn-lg" style="border-color:white;color:white">Find Us on Map</a>
        </div>
        <div class="hero-badges">
          <span>✓ Same-Day Response</span>
          <span>✓ Licensed & Insured</span>
          <span>✓ Upfront Pricing</span>
          <span>✓ 24/7 Emergency AC</span>
          <span>✓ Workmanship Guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section why-us">
    <div class="container">
      <p class="section-label">Gastonia's AC Repair Specialists</p>
      <h2>Why Gastonia Homeowners <em>Choose Us</em></h2>
      <p class="section-lead">
        Gastonia summers push residential cooling systems to their limit. When your AC
        struggles in 95°F heat, you need a <strong>licensed local specialist</strong> who knows
        Gaston County homes, responds the same day, and repairs it right the first time.
      </p>
      <div class="grid-2" style="margin-bottom:2rem">
        <article class="card">
          <h3>⚡ Same-Day Diagnosis & Repair</h3>
          <p>Most <strong>Same-Day AC Repair</strong> calls are completed within hours — no multi-day waits.</p>
        </article>
        <article class="card">
          <h3>🏅 Licensed & Certified</h3>
          <p>Technicians trained on modern refrigerants, including <strong>Refrigerant Leak Repair</strong>.</p>
        </article>
        <article class="card">
          <h3>💵 Upfront Pricing</h3>
          <p>We quote before we wrench. No hidden fees — honest <strong>Central AC Repair</strong> rates.</p>
        </article>
        <article class="card">
          <h3>📍 Local to Gaston County</h3>
          <p>Based in Gastonia at 503 E Franklin Blvd — faster response, better context.</p>
        </article>
      </div>
      <p style="text-align:center;color:var(--color-gray);margin-bottom:1.5rem">
        <strong>Proudly Serving Gastonia & All of Gaston County</strong><br />
        Belmont · Bessemer City · Cramerton · Dallas · Lowell · Stanley · and surrounding communities
      </p>
      <div class="stats">
        <div class="stat"><span class="stat-num">47 min</span><span class="stat-label">Avg. Response</span></div>
        <div class="stat"><span class="stat-num">98%</span><span class="stat-label">First-Visit Fix</span></div>
        <div class="stat"><span class="stat-num">24/7</span><span class="stat-label">Emergency Service</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-label">Common AC Problems</p>
      <h2>Recognize <em>These Signs?</em></h2>
      <p class="section-lead">Gastonia's heat and humidity accelerate AC wear. Don't wait — small issues compound fast.</p>
      <div class="grid-2">
        <a href="/problems/frozen-coils/" class="card problem-link">
          <h3>Frozen Coils <span class="badge badge-danger">Urgent</span></h3>
          <p>Ice on indoor or outdoor unit — restricted airflow or refrigerant leak. Needs emergency attention.</p>
        </a>
        <a href="/problems/blowing-warm-air/" class="card problem-link">
          <h3>Blowing Warm Air <span class="badge badge-danger">Urgent</span></h3>
          <p>AC runs but blows warm — low refrigerant or failing compressor. Same-day service recommended.</p>
        </a>
        <a href="/problems/leaking-water/" class="card problem-link">
          <h3>Leaking Water <span class="badge badge-danger">Urgent</span></h3>
          <p>Water pooling near unit — blocked condensate drain or melting ice. Call today.</p>
        </a>
        <a href="/problems/weak-airflow/" class="card problem-link">
          <h3>Weak Airflow <span class="badge badge-warn">Address Soon</span></h3>
          <p>Clogged filter, failing blower, or duct issues. Left alone, overloads the compressor.</p>
        </a>
        <a href="/problems/thermostat-issues/" class="card problem-link">
          <h3>Thermostat Issues <span class="badge badge-warn">Address Soon</span></h3>
          <p>Short-cycling, won't turn on, or ignores settings — often a fast, inexpensive fix.</p>
        </a>
        <a href="/problems/strange-noises/" class="card problem-link">
          <h3>Strange Noises <span class="badge badge-warn">Address Soon</span></h3>
          <p>Banging, squealing, grinding — loose hardware, worn bearings, or failing compressor.</p>
        </a>
      </div>
      <div style="text-align:center;margin-top:1.5rem">
        <a href="/problems/" class="btn btn-outline">View All Common Problems</a>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-light)">
    <div class="container">
      <p class="section-label">Residential AC Repair — Gastonia, NC</p>
      <h2>Expert AC <em>Repair Services</em></h2>
      <p class="section-lead">Diagnose accurately and repair correctly — from compressors to thermostats.</p>
      <div class="grid-2">
        <a href="/services/emergency-ac-repair/" class="card service-link highlight">
          <span class="tag">Urgent Response</span>
          <h3>Emergency AC Repair</h3>
          <p>24/7 service. Average on-site response under 60 minutes. Most repairs same visit.</p>
        </a>
        <a href="/services/central-ac-repair/" class="card service-link">
          <span class="tag">Most Common</span>
          <h3>Central AC Repair</h3>
          <p>Full-system repair for Carrier, Trane, Lennox & more. Written estimate before work.</p>
        </a>
        <a href="/services/mini-split-repair/" class="card service-link">
          <span class="tag">Ductless</span>
          <h3>Mini-Split Repair</h3>
          <p>Specialized repair for wall units, cassettes, multi-zone systems — all major brands.</p>
        </a>
        <a href="/services/compressor-repair/" class="card service-link">
          <span class="tag">Critical</span>
          <h3>Compressor Repair</h3>
          <p>Accurate diagnosis: repair vs. replace. Protect your investment with honest guidance.</p>
        </a>
        <a href="/services/refrigerant-leak-repair/" class="card service-link">
          <span class="tag">Certified</span>
          <h3>Refrigerant Leak Repair</h3>
          <p>Locate, seal, and recharge to manufacturer spec. Stop warm air and high bills.</p>
        </a>
        <a href="/services/thermostat-repair/" class="card service-link">
          <span class="tag">Quick Fix</span>
          <h3>Thermostat Repair</h3>
          <p>Restore reliable control and lower energy use — one of the fastest repairs.</p>
        </a>
        <a href="/services/same-day-ac-repair/" class="card service-link">
          <span class="tag">Fast Service</span>
          <h3>Same-Day AC Repair</h3>
          <p>Call in the morning, sleep in comfort that night. Available across Gaston County.</p>
        </a>
        <a href="/services/drain-line-cleaning/" class="card service-link">
          <span class="tag">Preventive</span>
          <h3>Drain Line Cleaning</h3>
          <p>Prevent overflow, mold, and shutdowns. Recommended every cooling season.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section urgency">
    <div class="container urgency-inner">
      <div>
        <span class="urgency-badge">● Priority Service Available Now</span>
        <h2>AC Down in the Gastonia Heat?</h2>
        <p>Don't suffer through a North Carolina summer without cooling. Our emergency team can respond today.</p>
      </div>
      <a href={`tel:${phone}`} class="btn btn-white btn-lg">Get a Quote — {phoneDisplay}</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section-label">Find Us</p>
      <h2>Our Location in <em>Gastonia, NC</em></h2>
      <p class="section-lead">503 E Franklin Blvd, Gastonia, NC 28054 — serving all of Gaston County.</p>
      <a href="/location/" class="btn btn-primary">View Map & Directions</a>
    </div>
  </section>

  <style>
    .hero {
      background: linear-gradient(135deg, #0c4a6e 0%, #0ea5e9 50%, #14b8a6 100%);
      color: white; padding: 3.5rem 0 4rem;
    }
    .hero-inner { max-width: 800px; }
    .hero h1 { font-size: clamp(1.75rem, 5vw, 2.75rem); font-weight: 800; line-height: 1.2; margin-bottom: 0.75rem; }
    .hero-tagline { font-size: 1.25rem; font-weight: 600; opacity: 0.95; margin-bottom: 1rem; }
    .hero-desc { font-size: 1.05rem; opacity: 0.9; margin-bottom: 1.75rem; max-width: 600px; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.75rem; }
    .hero-badges { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; font-size: 0.875rem; opacity: 0.95; }
    .why-us { background: var(--color-light); }
    .stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; }
    .stat { text-align: center; }
    .stat-num { display: block; font-size: 2rem; font-weight: 800; color: var(--color-primary-dark); }
    .stat-label { font-size: 0.875rem; color: var(--color-gray); }
    .problem-link:hover, .service-link:hover { border-color: var(--color-primary); box-shadow: 0 4px 12px rgba(14,165,233,0.12); }
    .service-link .tag { font-size: 0.75rem; font-weight: 600; color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.04em; display: block; margin-bottom: 0.35rem; }
    .service-link.highlight { border-color: var(--color-primary); box-shadow: 0 4px 12px rgba(14,165,233,0.15); }
    .urgency {
      background: linear-gradient(135deg, #0c4a6e, #0ea5e9); color: white; padding: 2.5rem 0;
    }
    .urgency-inner { display: flex; flex-direction: column; gap: 1.5rem; align-items: flex-start; }
    @media (min-width: 768px) {
      .urgency-inner { flex-direction: row; align-items: center; justify-content: space-between; }
    }
    .urgency-badge { display: inline-block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.5rem; opacity: 0.9; }
    .urgency h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
    .urgency p { opacity: 0.95; max-width: 500px; }
  </style>
</Layout>
