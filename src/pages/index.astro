          <a href={`tel:${phone}`} class="btn btn-primary btn-lg">Call {phoneDisplay}</a>
          <a href="#location" class="btn btn-outline btn-lg">Find Us on Map</a>
        </div>
        <div class="hero-badges">
          <span>✓ Same-Day Response</span>
          <span>✓ Licensed & Insured</span>
          <span>✓ Upfront Pricing</span>
          <span>✓ 24/7 Emergency AC</span>
