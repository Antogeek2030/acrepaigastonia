      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.5rem;
    }
    .service-card h3 {
      font-size: 1.2rem;
      margin-bottom: 0.75rem;
    }
    .service-card p {
      font-size: 0.95rem;
      color: var(--color-gray);
      margin-bottom: 1rem;
      flex-grow: 1;
    }
    .service-card ul {
      margin-bottom: 1.25rem;
      font-size: 0.9rem;
    }
    .service-card ul li {
      padding: 0.25rem 0;
      padding-left: 1.25rem;
      position: relative;
    }
    .service-card ul li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: 700;
    }

    /* Urgency */
    .urgency {
      background: linear-gradient(135deg, #0c4a6e, #0ea5e9);
      color: white;
      padding: 2.5rem 0;
    }
    .urgency-inner {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      align-items: flex-start;
    }
    @media (min-width: 768px) {
      .urgency-inner {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }
    .urgency-badge {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      opacity: 0.9;
    }
    .urgency h2 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }
    .urgency p { opacity: 0.95; max-width: 500px; }

    /* Timing */
    .timeline {
      display: grid;
      gap: 1rem;
      margin-top: 2rem;
    }
    @media (min-width: 768px) {
      .timeline { grid-template-columns: repeat(4, 1fr); }
    }
    .timeline-item {
      background: var(--color-light);
      border-radius: 10px;
