    /* Sections common */
    .section {
      padding: 3.5rem 0;
    }
    .section-label {
      color: var(--color-primary);
      font-weight: 600;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }
    .section h2 {
      font-size: clamp(1.5rem, 4vw, 2.25rem);
